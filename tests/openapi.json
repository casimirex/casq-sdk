  "info": {
    "title": "casimirQ API",
    "description": "REST API for the casimirQ quantum circuit simulation platform: authentication, circuits, simulation, asynchronous jobs, algorithms, visualizations, and advanced features (error correction, noise, quantum ML).",
    "version": "1.0.0",
    "contact": {},
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Login, signup, token refresh, and identity"
    },
    {
      "name": "Circuits",
      "description": "Create, read, update, delete circuits and simulate them"
    },
    {
      "name": "Simulations",
      "description": "Synchronous simulation runs and history"
    },
    {
      "name": "Jobs",
      "description": "Asynchronous job engine: submit, poll, cancel"
    },
    {
      "name": "Algorithms",
      "description": "Pre-built quantum algorithms (QFT, Grover, Shor, VQE, QAOA, ...)"
    },
    {
      "name": "Visualizations",
      "description": "Bloch sphere, circuit diagrams, histograms"
    },
    {
      "name": "Advanced",
      "description": "Error correction, noise modeling, quantum machine learning"
    },
    {
      "name": "IO",
      "description": "Import / export circuits (QASM and other formats)"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Docker (nginx single-origin)"
    },
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local backend"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "QFTDto": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number",
            "minimum": 1,
            "maximum": 16
          }
        },
        "required": [
          "n"
        ]
      },
      "GroverDto": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number",
            "minimum": 1,
            "maximum": 16
          },
          "markedItem": {
            "type": "number",
            "minimum": 0
          },
          "iterations": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "n",
          "markedItem"
        ]
      },
      "VQEDto": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number",
            "minimum": 1,
            "maximum": 16
          },
          "hamiltonian": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "maxIterations": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "n",
          "hamiltonian"
        ]
      },
      "QAOADto": {
        "type": "object",
        "properties": {
          "n": {
            "type": "number",
            "minimum": 1,
            "maximum": 16
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "p": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "n",
          "edges"
        ]
      },
      "TeleportDto": {
        "type": "object",
        "properties": {
          "alpha": {
            "type": "number"
          },
          "beta": {
            "type": "number"
          }
        },
        "required": [
          "alpha",
          "beta"
        ]
      },
      "ShorDto": {
        "type": "object",
        "properties": {
          "N": {
            "type": "number",
            "minimum": 2
          }
        },
        "required": [
          "N"
        ]
      },
      "SimulateNoiseDto": {
        "type": "object",
        "properties": {
          "numQubits": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "noise": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "shots": {
            "type": "number",
            "minimum": 1
          },
          "seed": {
            "type": "number"
          },
          "computeFidelity": {
            "type": "boolean"
          }
        },
        "required": [
          "numQubits"
        ]
      },
      "ImportDto": {
        "type": "object",
        "properties": {}
      },
      "ExportDto": {
        "type": "object",
        "properties": {}
      },
      "ConvertDto": {
        "type": "object",
        "properties": {}
      },
      "ValidateDto": {
        "type": "object",
        "properties": {}
      },
      "BlochSphereDto": {
        "type": "object",
        "properties": {}
      },
      "CircuitDiagramDto": {
        "type": "object",
        "properties": {}
      },
      "AmplitudeVisualizationDto": {
        "type": "object",
        "properties": {}
      },
      "AnimationDto": {
        "type": "object",
        "properties": {}
      },
      "EntanglementGraphDto": {
        "type": "object",
        "properties": {}
      },
      "SubmitSimulationJobDto": {
        "type": "object",
        "properties": {
          "circuitName": {
            "type": "string"
          },
          "numQubits": {
            "type": "number",
            "minimum": 1,
            "maximum": 24
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "engine": {
            "type": "string"
          },
          "shots": {
            "type": "number",
            "minimum": 1
          },
          "seed": {
            "type": "number"
          }
        },
        "required": [
          "numQubits"
        ]
      },
      "RunOnBackendDto": {
        "type": "object",
        "properties": {
          "numQubits": {
            "type": "number",
            "minimum": 1
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "shots": {
            "type": "number",
            "minimum": 1
          },
          "seed": {
            "type": "number"
          },
          "noise": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "numQubits"
        ]
      }
    }
  }
}
